+/// (C# `MegaCrit.Sts2.Core.Models.Relics/PaelsTears.cs:136-139`, v0.111.0). The
+/// latch rides in `counter`, which the run flushes across combats, so a combat that
+/// ended on a skipped turn-start walk carried +2 energy into the next fight's turn 1
+/// (lockstep vs the v0.111.0 DLL, seed full_145).
+pub(crate) fn on_after_combat_end_paels_tears(state: &mut CombatState) -> EffectResult {
+    let Some(r) = paels_tears_relic_mut(state) else {
+        return EffectResult::NotImplemented;
+    };
+    r.counter = 0;
+    EffectResult::Resolved
+}
